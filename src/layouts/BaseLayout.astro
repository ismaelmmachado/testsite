---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Practical how-to notes from Rafael Costa.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: title,
  description,
  url: canonical,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — testsite</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} — testsite`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — testsite`} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style>
      .container {
        width: 100%;
        max-width: 72rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
      }
      .content {
        max-width: 48rem;
        margin-left: auto;
        margin-right: auto;
        padding-top: 3rem;
        padding-bottom: 3rem;
      }
      .skip-link {
        position: absolute;
        transform: translate(-9999px);
      }
      .skip-link:focus {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        background: #fff;
        border: 1px solid #e4e4e7;
        padding: 0.5rem 0.75rem;
        border-radius: 0.25rem;
        transform: translate(0);
      }
      .site-header {
        border-bottom: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.85);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      .brand {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--color-ink);
        text-decoration: none;
      }
      .nav-link {
        margin-left: 1rem;
        font-size: 0.9rem;
        color: var(--color-ink-muted);
        text-decoration: none;
      }
      .nav-link:hover {
        color: var(--color-ink);
      }
      .site-footer {
        border-top: 1px solid var(--color-border);
        padding-top: 2rem;
        padding-bottom: 2rem;
        font-size: 0.9rem;
        color: var(--color-ink-muted);
      }
      .section + .section {
        margin-top: 2.5rem;
      }
      .card {
        border: 1px solid var(--color-border);
        border-radius: 0.5rem;
        padding: 1rem;
        background: var(--color-surface);
      }
      .card-raised {
        background: var(--color-surface-raised);
      }
      .grid-3 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      @media (min-width: 768px) {
        .grid-3 {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      .grid-2 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      @media (min-width: 768px) {
        .grid-2 {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .list + .list {
        margin-top: 1rem;
      }
      .list-item + .list-item {
        margin-top: 0.75rem;
      }
    </style>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">testsite</a>
        <nav>
          <a href="/" class="nav-link">Home</a>
          <a href="/guide/" class="nav-link">Guide</a>
          <a href="/about/" class="nav-link">About</a>
        </nav>
      </div>
    </header>

    <main id="main" class="container content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} testsite. Built for clarity.
      </div>
    </footer>
  </body>
</html>
