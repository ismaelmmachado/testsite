---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Practical how-to notes from Rafael Costa.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: title,
  description,
  url: canonical,
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — testsite</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} — testsite`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — testsite`} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">testsite</a>
        <nav>
          <a href="/" class="nav-link" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/guide/" class="nav-link" aria-current={Astro.url.pathname === '/guide/' ? 'page' : undefined}>Guide</a>
          <a href="/about/" class="nav-link" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} testsite. Built for clarity.
      </div>
    </footer>
  </body>
</html>
